// class Step{

// }
public class TPTP {
    private Set<String> stepNames=new HashSet<String>(); //store step names
    private String runStepName = null;

    private static boolean nonSimple = false;
    private static int lastNumeral = 0;
    private static String currentID1 = null;
    private static String currentID2 = null;
    
    public static void main( String[] args ) throws ParseException {
        TPTP parser = new TPTP( System.in ) ;
        try{
            parser.Program(); 
            System.out.println("Success");
            if(nonSimple){
                System.out.println("Non-simple");
            }
            else{
                System.out.println("Simple");
            }
        }
        catch(ParseException e){
            System.out.println("Failure");
            System.err.println(e.currentToken.next.beginLine);
            System.err.println("Syntax Error: " + e.getMessage());
        }
        catch(TokenMgrError e){
            System.out.println("Failure");
            String msg = e.getMessage();
            int lineIndex = msg.indexOf("line ");
            int commaIndex = msg.indexOf(",", lineIndex);

            if (lineIndex != -1 && commaIndex != -1) {
                String lineNumber = msg.substring(lineIndex + 5, commaIndex);
                System.err.println(lineNumber);
            } else {
                System.err.println("Unknown line");
            }
        } 
        catch (Exception e){
            System.out.println("Failure");
            System.err.println("0");
            System.err.println(e.getMessage());
        }
    }
    private static void markNonSimple(){
        nonSimple = true;
    }  
}
PARSER_END(TPTP)

//Tokens stuff


SKIP: {" " | "\n"|"\t"|"\r"} //skips

//reserved keywords 
TOKEN: {
    <RUN: "run"> |
    <IF: "if"> |
    <BECOMES: "becomes"> |
    <ELSE: "else"> | 
    <AND: "and">
}

//punctuation
TOKEN: {<COLON:":"> | <COMMA:","> | <LT:"<"> | <LPAREN:"("> | <RPAREN:")">|<SEMICOLON:";">}

//arithmetic
TOKEN: {<PLUS:"+"> | <MINUS:"-"> | <MULT:"*">}



//arithmetic numbers
TOKEN: {<NUMERAL: (["0"-"9"])+>|
        <IDENTIFIER: <LETTER>(<LETTER> | ["0"-"9"] | "_")*> |
        <LETTER: (["a"-"z"] | ["A"-"Z"])>
}
// unexpected symbols
TOKEN: {<UNEXPECTED: ~[]>}

void Program():{}
{
    (Step() <SEMICOLON>)+
    Run()
    <EOF>
    {
        if(!stepNames.contains(runStepName)){
            throw new ParseException("Step '" + runStepName + "' mentioned in run instruction does not exist.");
        }
    }
}
void pairID():{
    Token id1Tok;
    Token id2Tok;
    String id1;
    String id2;
}{
    <LPAREN> id1Tok = <IDENTIFIER> <COMMA> id2Tok=<IDENTIFIER> <RPAREN>
    {
        id1=id1Tok.image;
        id2=id2Tok.image;
        // recordParameterPair(token.beginLine, id1, id2);
    }
}
void Step():
{
    Token name;
    Token id1, id2;
    Token nextStep, elseStep;
    String cond;
    ArithExpression e1=null, e2=null, e3=null, e4=null;
    boolean isSimple;
}
{
    name = <IDENTIFIER>
    {
        //COnd 8
        if(stepNames.contains(name.image)){
            throw new ParseException("Duplicate step name: " + name.image);
        }
        stepNames.add(name.image);
    }
    
    <COLON> <IF> cond=Cond()
    // pairID()
    <LPAREN> id1 = <IDENTIFIER> <COMMA> id2=<IDENTIFIER> <RPAREN>
    {
        currentID1 = id1.image;
        currentID2 = id2.image;
        if (!cond.equals(currentID1) && !cond.equals(currentID2)) {
            throw new ParseException("Condition identifier must be one of the parameters.");
        }
    }
    //optional long form
    [<BECOMES> <LPAREN> e1=Expr(false) <COMMA> e2=Expr(false) <RPAREN> <AND>]
    nextStep=<IDENTIFIER>
    
    <ELSE>

    //optional Long form branch False
    [<LPAREN> e3=Expr(true) <COMMA> e4=Expr(true) <RPAREN> <AND>]
    elseStep=<IDENTIFIER>
    {
        // Further Condition 6: id1 and id2 must be different
        if (id1.image.equals(id2.image)) {
            throw new ParseException("Parameter names must be different in step: " + name);
        }
    }
}

String Cond():{
    Token condIDTok;
    Token numTok;
    String condID;
}
{
    
    condIDTok=<IDENTIFIER> <LT> numTok=<NUMERAL>
    { 
        return condIDTok.image;
    }
}

void Run() :
{
    Token StepName;
    Token n1Token,n2Token;
}
{
    <RUN> StepName=<IDENTIFIER> <LPAREN> n1Token=<NUMERAL> <COMMA> n2Token=<NUMERAL> <RPAREN>
    {
        runStepName = StepName.image;
    }
}

ArithExpression Expr(boolean allowsNegatives):{
    ArithExpression exp = new ArithExpression();
    boolean termWasNumeral;
}
{
    Term(allowsNegatives,exp)
    ( "+" Term(allowsNegatives,exp)

    |
    "-" termWasNumeral=Term(allowsNegatives, exp)
    {
        //Rule s E1/E2 cannot have subtraction
        if (!allowsNegatives){
            markNonSimple();
        }
        //Rule p:
        if(!termWasNumeral){
            markNonSimple();
        } else{
            exp.numSum -= (2*lastNumeral); //double negate as added prevbiously
        }

    }
    )*
    {
        return exp;
    }
}
boolean Term(boolean allowsNegatives, ArithExpression exp):{
    boolean factorWasNumeral;
}
{
    factorWasNumeral=Factor(allowsNegatives,exp)
    (
        "*" Factor(allowsNegatives, exp)
        {
            //multiplication makes expression non positive
            markNonSimple();
        }
    )*
    {
        return factorWasNumeral;
    }
    
}

boolean Factor(boolean allowsNegatives, ArithExpression exp):
{
    Token numeralToken;
    Token idToken;
    int numeral;
    boolean isNumeral=false;
    boolean factorWasNumeral;
    ArithExpression nestedExp;
}
{
    (
        numeralToken = <NUMERAL>
        {
            isNumeral=true;
            numeral=Integer.parseInt(numeralToken.image);
            lastNumeral=numeral;
            exp.numSum +=numeral;
        }

        |
        idToken = <IDENTIFIER>
        {
            //must be ID1 or ID2
            if(idToken.image.equals(currentID1)){
                exp.id1Count++;
            } else if (idToken.image.equals(currentID2)){
                exp.id2Count++;
            } else{
                throw new ParseException("Identifier '" + idToken.image + "' is not a parameter in this step.");
            }
        }
        |
        <LPAREN> nestedExp=Expr(allowsNegatives) <RPAREN>
        {
            exp.merge(nestedExp);
        }
    )
    {
        return isNumeral;
    }
}

